{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@zunos/ui/*": [
        "../../packages/ui/src/*"
      ]
    }
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src",
    "modules"
  ]
}
