# Copy to apps/api/.env for local development (Bun loads it automatically; it is gitignored).
# `hexclave dev` supplies HEXCLAVE_PROJECT_ID, HEXCLAVE_PUBLISHABLE_CLIENT_KEY and HEXCLAVE_API_URL.
# In production every value comes from hexclave.deploy.ts and the dashboard's Project Settings → Secrets.

# Who may launch training (comma-separated, case-insensitive).
ALLOWED_EMAILS=you@example.com

# Signed blob URLs point here. A real pod can't reach localhost: end-to-end runs need a tunnel or a deploy.
PUBLIC_URL=http://localhost:3000
# Any long random string, e.g. `openssl rand -hex 32`.
BLOB_SIGNING_SECRET=dev-only-blob-signing-secret-change-me

# 1 = never call Runpod; pods are faked in memory. Keep this on for local development.
RUNPOD_MOCK=1
RUNPOD_API_KEY=
HF_TOKEN=

# Defaults: DATA_DIR=apps/api/data, PORT=3000, REPO_DIR=the repo root.
# DATA_DIR=
# PORT=3000

POD_IMAGE=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
GPU_TYPES=NVIDIA A40,NVIDIA RTX A6000,NVIDIA L40S
MAX_HOURLY_USD=2
MAX_RUN_HOURS=4
